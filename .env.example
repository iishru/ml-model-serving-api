# Copy this file to .env and change the password:   cp .env.example .env
# docker compose reads .env automatically. Never commit .env.

# --- PostgreSQL (used by the db service and to build the API's DATABASE_URL in Docker)
POSTGRES_USER=mlapi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=predictions

# --- API
# Shown in every /predict response and stored with every logged prediction.
MODEL_VERSION=rf-v1
# Local (non-Docker) runs only: where the API should log predictions.
# In Docker this is built from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg2://mlapi:change-me@localhost:5432/predictions
# Optional: seconds to keep retrying the database at startup.
DB_CONNECT_TIMEOUT_S=30

# --- Drift monitor
DRIFT_WINDOW=100
DRIFT_THRESHOLD=2.0
DRIFT_KS_P_VALUE=0.01
DRIFT_MIN_SAMPLES=30

# --- Training (local runs): where train.py sends MLflow runs
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- Traffic simulation: where simulate_traffic.py sends requests
API_URL=http://localhost:8000
